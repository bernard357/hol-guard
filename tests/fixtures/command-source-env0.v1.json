                    "env0",
                    "env0.exe",
                    "env0.cmd"
                  ],
                  "fail_secure_unknown_options": true,
                  "forbidden_flags": [],
                  "interspersed_flags": [
                    "--yes"
                  ],
                  "interspersed_options_with_values": [
                    "--organization"
                  ],
                  "inverse_flag_pairs": [],
                  "leading_options_with_values": [
                    "--organization"
                  ],
                  "options_with_values": [],
                  "required_flags": [],
                  "required_flags_in_all_arguments": false,
                  "required_option_values": [],
                  "subcommands": [
                    "environment",
                    "destroy"
