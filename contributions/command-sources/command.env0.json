{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "extension_id": "command.env0",
    "version": "1.0.0",
    "name": "env zero CLI command protection",
    "description": "External, local opt-in review rules for four documented high-impact env zero CLI environment and deployment operations. Independent HOL-authored proposal; env zero does not bundle, maintain, or endorse this contribution.",
    "action_classes": ["env zero environment destruction","env zero deployment cancellation","env zero deployment abort","env zero deployment approval"],
    "risk_classes": ["destructive_shell","network_egress"],
    "safer_alternatives": ["Inspect the exact environment ID and `env0 context <environment-id>` before approving an infrastructure destroy.","Review `env0 deployment list --environment <environment-id>` and identify the pending deployment before canceling.","Inspect `env0 deployment logs <deployment-id>` and confirm the active deployment before aborting.","Inspect the pending plan and current approval requirement before granting deployment approval."],
    "reference_urls": ["https://docs.envzero.com/guides/community-and-resources/support-and-help/env-zero-cli","https://docs.envzero.com/guides/community-and-resources/support-and-help/env-zero-cli/command-reference"],
    "required": false,
    "source": "built-in",
    "aliases": [],
    "dependencies": [],
    "conflicts": [],
    "ecosystem_ids": ["env0"],
    "executables": ["env0","env0.exe","env0.cmd"],
    "project_markers": [],
    "permissions": [
      {
        "permission_id": "command.env0.permission.destroy-environment",
        "implementation_version": "1.0.0",
        "label": "Destroy managed environment",
        "description": "Destroys cloud infrastructure associated with an existing env zero environment.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": ["env zero environment destruction"],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": ["Inspect the exact environment ID and `env0 context <environment-id>` before approving an infrastructure destroy."],
        "example_command": "env0 environment destroy <environment-id> --yes"
      },
      {
        "permission_id": "command.env0.permission.cancel-deployment",
        "implementation_version": "1.0.0",
        "label": "Cancel pending deployment",
        "description": "Cancels a pending deployment or approval-stage operation.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": ["env zero deployment cancellation"],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": ["Review `env0 deployment list --environment <environment-id>` and identify the pending deployment before canceling."],
        "example_command": "env0 deployment cancel <deployment-id>"
      },
      {
        "permission_id": "command.env0.permission.abort-deployment",
        "implementation_version": "1.0.0",
        "label": "Abort running deployment",
        "description": "Aborts a currently running deployment and can interrupt infrastructure changes.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": ["env zero deployment abort"],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": ["Inspect `env0 deployment logs <deployment-id>` and confirm the active deployment before aborting."],
        "example_command": "env0 deployment abort <deployment-id>"
      },
      {
        "permission_id": "command.env0.permission.approve-deployment",
        "implementation_version": "1.0.0",
        "label": "Approve held deployment",
        "description": "Approves a pending deployment and can authorize infrastructure changes.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": ["env zero deployment approval"],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": ["Inspect the pending plan and current approval requirement before granting deployment approval."],
        "example_command": "env0 deployment approve <deployment-id>"
