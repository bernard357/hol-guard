              "upctl.exe",
              "upctl.cmd"
            ],
            "subcommands": [
              "all",
              "purge"
            ],
            "options_with_values": [
              "--config",
              "--output",
              "-o",
              "--client-timeout",
              "-t"
            ],
            "interleaved_options_with_values": [
              "--config",
              "--output",
              "-o",
              "--client-timeout",
              "-t"
            ],
            "forbidden_flags_before_delimiter": [
              "--help",
              "-h"
            ]
          }
        }
      }
    ],
    "project_markers": [],
