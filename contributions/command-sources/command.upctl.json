            "interspersed_options_with_values": [
              "--include",
              "-i",
              "--exclude",
              "-e"
            ],
            "inverse_flag_pairs": [],
            "leading_options_with_values": [],
            "options_with_values": [
              "--include",
              "-i",
              "--exclude",
              "-e"
