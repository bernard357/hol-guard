{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "extension_id": "command.upctl",
    "name": "UpCloud upctl destructive purge review",
    "version": "1.0.0",
    "license": null,
    "source": "built-in",
    "required": false,
    "risk_classes": [
      "destructive_shell",
      "network_egress"
    ],
    "description": "Locally opt-in HOL-authored review of UpCloud upctl all purge, which can force-delete account resources and disable termination protection. Not maintained or endorsed by UpCloud.",
    "homepage": "https://github.com/UpCloudLtd/upcloud-cli",
    "executables": [
      "upctl"
    ],
    "action_classes": [
      "UpCloud account resource purge"
    ],
    "aliases": [],
    "conflicts": [],
    "dependencies": [],
    "ecosystem_ids": [],
    "delegated_protection": null,
    "icon": {
      "kind": "none"
    },
    "publisher": {
      "id": "community.kantorcodes",
      "display_name": "Michael Kantor",
      "url": "https://github.com/kantorcodes"
    },
    "permissions": [
      {
        "permission_id": "command.upctl.permission.account-purge",
        "implementation_version": "1.0.0",
        "label": "UpCloud account-wide resource purge",
        "description": "Request review before upctl all purge, an unbounded best-effort resource deletion command that disables termination protection and may retry until canceled.",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "UpCloud account resource purge"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Preview exact targets with upctl all list and restrict --include/--exclude filters; do not use account-wide purge without independent approval."
        ],
        "risk_tier": "critical",
        "baseline_floor": "review",
        "example_command": "upctl all purge --include 'tf-acc-test*'"
      }
    ],
    "rules": [
      {
        "rule_id": "command.upctl.account-purge",
        "rule_version": "1.0.0",
        "permission_id": "command.upctl.permission.account-purge",
        "title": "UpCloud account resource purge",
        "description": "Request review before upctl all purge, an unbounded best-effort resource deletion command that disables termination protection and may retry until canceled.",
        "severity": "critical",
        "risk_classes": [
          "destructive_shell",
          "network_egress"
        ],
        "action_classes": [
          "UpCloud account resource purge"
        ],
        "safer_alternatives": [
          "Preview exact targets with upctl all list and restrict --include/--exclude filters; do not use account-wide purge without independent approval."
        ],
        "default_mode": "review",
        "safe_variants": [],
