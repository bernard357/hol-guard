{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "extension_id": "command.upctl",
    "version": "1.0.0",
    "name": "UpCloud CLI purge review",
    "description": "HOL-authored external, locally opt-in review of UpCloud upctl's account-wide purge command. This independent policy is not bundled, maintained or endorsed by UpCloud.",
    "action_classes": [
      "UpCloud account-wide purge"
    ],
    "risk_classes": [
      "destructive_shell"
    ],
    "safer_alternatives": [
      "Preview targeted resources with `upctl all list` and inspect include/exclude filters; purge can delete resources even when termination protection is set."
    ],
    "reference_urls": [
      "https://github.com/UpCloudLtd/upcloud-cli/blob/main/internal/commands/all/purge.go",
      "https://github.com/UpCloudLtd/upcloud-cli"
    ],
    "required": false,
    "source": "built-in",
    "aliases": [],
    "dependencies": [],
    "conflicts": [],
    "ecosystem_ids": [
      "upcloud"
    ],
    "executables": [
      "upctl",
      "upctl.exe",
      "upctl.cmd"
    ],
    "project_markers": [],
    "permissions": [
      {
        "permission_id": "command.upctl.permission.all-purge",
        "implementation_version": "1.0.0",
        "label": "UpCloud account-wide purge",
        "description": "Reviews `upctl all purge`, an account-wide cleanup operation that may force-delete resources and can retry failures until externally stopped.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "UpCloud account-wide purge"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Preview targeted resources with `upctl all list` and inspect include/exclude filters; purge can delete resources even when termination protection is set."
        ],
        "example_command": "upctl all purge --include '*staging*'"
      }
    ],
    "rules": [
      {
        "rule_id": "command.upctl.all-purge",
        "rule_version": "1.0.0",
        "permission_id": "command.upctl.permission.all-purge",
        "title": "UpCloud account-wide purge",
        "description": "Reviews `upctl all purge`, an account-wide cleanup operation that may force-delete resources and can retry failures until externally stopped.",
        "severity": "high",
        "risk_classes": [
          "destructive_shell"
        ],
        "action_classes": [
          "UpCloud account-wide purge"
        ],
        "safer_alternatives": [
          "Preview targeted resources with `upctl all list` and inspect include/exclude filters; purge can delete resources even when termination protection is set."
        ],
        "default_mode": "review",
        "matcher": {
